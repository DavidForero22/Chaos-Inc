APP_NAME="Chaos Inc."
APP_ENV=local              # local | production
APP_KEY=                   # Generar con: php artisan key:generate
APP_DEBUG=true             # Poner false en producción
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

FRANKENPHP_CONFIG="worker ./public/index.php"
SERVER_NAME=":8000"

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug             # Cambiar a "error" en producción

DB_CONNECTION=mysql
DB_HOST=mysql               # Nombre del servicio en docker-compose
DB_PORT=3306
DB_DATABASE=chaosinc_game_db
DB_USERNAME=chaosinc_admin

REDIS_CLIENT=phpredis
REDIS_HOST=redis            # Nombre del servicio en docker-compose
REDIS_PORT=6379
REDIS_PREFIX=""

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_EXPIRE_ON_CLOSE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (WebSockets) ---
# En producción: REVERB_SCHEME=https y REVERB_HOST=tu.dominio.com
REVERB_APP_ID=             # ID de tu app Reverb
REVERB_APP_KEY=            # Clave pública de Reverb
REVERB_APP_SECRET=         # Secreto de Reverb
REVERB_HOST="reverb"       # Nombre del servicio en docker-compose
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="reverb"
PUSHER_PORT=8080
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER="mt1"

# --- OAuth: Google ---
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- OAuth: Discord ---
# Crear en: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# --- Super Admin (seed inicial) ---
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Reverb Webhooks ---
REVERB_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/reverb
REVERB_APP_PING_INTERVAL=10
REVERB_APP_ACTIVITY_TIMEOUT=15