# Construcción con Bun
FROM oven/bun:1.2-slim AS builder

WORKDIR /app

# Copiar archivos de configuración de dependencias desde la subcarpeta frontend
COPY ./frontend/package.json ./frontend/bun.lock* ./

# Instalar dependencias
RUN bun install --frozen-lockfile

# Copiar todo el contenido de la carpeta frontend al WORKDIR (/app)
COPY ./frontend/ .

# Declarar los ARG que envía Docker Compose (Crucial para Vite en producción)
ARG VITE_API_URL
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT
ARG VITE_REVERB_SCHEME

# Pasarlos como variables de entorno para que Vite los inyecte en el build
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY
ENV VITE_REVERB_HOST=$VITE_REVERB_HOST
ENV VITE_REVERB_PORT=$VITE_REVERB_PORT
ENV VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME

# Compilar la aplicación (Ejecuta tsc -b && vite build)
RUN bun run build

# Servidor de Producción con Nginx
FROM nginx:alpine

# Copiar la configuración personalizada de Nginx
COPY ./docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar los archivos compilados desde la fase anterior
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]